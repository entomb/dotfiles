[user]
  name = Jonathan Tavares
  email = jonathan@wearesingular.com

[init]
  defaultBranch = main

[core]
  editor = nvim
  # delta, not less: it syntax-highlights and understands word-level moves
  # (delta --version to confirm it is on PATH).
  pager = delta

[push]
  default = upstream
  autoSetupRemote = true

[pull]
  rebase = true

[branch]
  autosetuprebase = always

[merge]
  # Shows the common ancestor line as well as ours and theirs, so a three-way
  # conflict is readable without having to reconstruct it.
  conflictstyle = diff3

[diff]
  colorMoved = default

[interactive]
  # Side-by-side highlighting only; the pager still does the paging.
  diffFilter = delta --color-only

[delta]
  navigate = true
  line-numbers = true

[color]
  ui = auto
  diff = auto
  status = auto
  branch = auto
  interactive = auto
  pager = true

[color "status"]
  added = green
  changed = blue
  untracked = magenta
  deleted = red

[alias]
  fix = commit --amend
  ignore = update-index --assume-unchanged
  unignore = update-index --no-assume-unchanged
  ignored = !git ls-files -v | grep "^[[:lower:]]"
  lg = log --graph --abbrev-commit --decorate --format=format:'%C(blue)%h%C(reset) - %C(bold green)(%ar)%C(reset) %C(white)%s%C(reset) %C(dim white)- %an%C(reset)%C(bold yellow)%d%C(reset)' --all
  lgdiff = log --oneline --graph --first-parent --decorate --left-right

[advice]
  # The advice is correct and just restates what the output already showed.
  skippedCherryPicks = false
  statusHints = false
  statusUoption = false
  rmHints = false

[filter "lfs"]
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f
  process = git-lfs filter-process
  required = true

# Untracked identity, trust exceptions and machine-specific tool choices.
[include]
  path = ~/.gitconfig.local
