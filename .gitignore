# Sensitive files - never commit these
.ssh/id_*
.ssh/*.pem
.ssh/*.key
.gnupg/
.password-store/
.aws/credentials
.docker/config.json

# Files that often contain secrets
.env
.env.*
# Per-machine secrets, sourced by .bashrc. This is a dotfile, not a template:
# the committed file is .secret.example. Keep this rule.
.secret
.secret.*
!.secret.example
*.key
*.pem
*.p12
*.pfx
*_rsa
*_dsa
*_ecdsa
*_ed25519

# API tokens and credentials
.netrc
.authinfo
.curlrc
.npmrc
.yarnrc

# Cloud provider configs with potential credentials
.azure/
.config/gcloud/
.kube/config

# Database configs that might have passwords
.pgpass
.my.cnf
.psqlrc

# Backup files and system files
*~
*.swp
*.swo
.DS_Store
Thumbs.db

# Local testing/temporary
test_secrets.sh
local_config.sh

# Machine overrides and generated editor state
.gitconfig.local

# Generated palettes, logs and runtime state
*.log
.config/nvim/lua/matugen.lua
.config/niri/accent.kdl
.config/foot/themes/noctalia
.config/herdr/noctalia-colors.toml
.config/herdr/session.json
.config/herdr/*.sock
