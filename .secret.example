# Template for ~/.secret — the per-machine secrets file.
#
# Copy to ~/.secret, fill in real values, and `chmod 600 ~/.secret`.
#   cp ~/.secret.example ~/.secret && chmod 600 ~/.secret
#
# ~/.bashrc sources ~/.secret if it exists, which is what keeps .bashrc itself
# machine-agnostic. This file is the only place tokens belong.
#
# This template is committed; a real ~/.secret is not, and must never be.
# Leave a key out entirely rather than setting it empty — .bashrc does not care
# either way, but an empty value can shadow a value set elsewhere.

# ngrok
export NGROK_AUTHTOKEN=

# DigitalOcean
export DI_TOKEN=

# Model and agent providers
export OPENROUTER_API_KEY=
export OPENCODE_API_KEY=

# Context7 MCP authentication, referenced by OpenCode via {env:CONTEXT7_API_KEY}.
export CONTEXT7_API_KEY=

# Daytona (dev environments)
export DAYTONA_API_KEY=
