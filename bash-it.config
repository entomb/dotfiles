#!/usr/bin/env bash
# Bash-it Configuration Setup Script
# This script installs and configures bash-it with your preferred settings

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BASH_IT_DIR="${BASH_IT:-$HOME/.bash_it}"

echo "=== Bash-it Configuration Setup ==="
echo ""

# Check if bash-it is installed
if [ ! -d "$BASH_IT_DIR" ]; then
    echo "❌ Bash-it not found at $BASH_IT_DIR"
    echo ""
    echo "Would you like to install it now? (y/n)"
    read -r response
    if [[ "$response" =~ ^[Yy]$ ]]; then
        echo "Installing bash-it..."
        git clone --depth=1 https://github.com/Bash-it/bash-it.git "$BASH_IT_DIR"
        bash "$BASH_IT_DIR/install.sh" --silent
        echo "✓ Bash-it installed"
    else
        echo "Please install bash-it first:"
        echo "  git clone --depth=1 https://github.com/Bash-it/bash-it.git ~/.bash_it"
        echo "  ~/.bash_it/install.sh"
        exit 1
    fi
fi

echo "✓ Bash-it found at $BASH_IT_DIR"
echo ""

# Source bash-it to get the bash-it command
export BASH_IT="$BASH_IT_DIR"
source "$BASH_IT/bash_it.sh"

# Enable aliases
echo "Enabling aliases..."
for alias_name in general node; do
    if bash-it enable alias "$alias_name" &>/dev/null; then
        echo "  ✓ $alias_name"
    else
        echo "  ⚠ $alias_name (already enabled or not found)"
    fi
done
echo ""

# Enable plugins
echo "Enabling plugins..."
for plugin in nvm base colors docker-compose git man; do
    if bash-it enable plugin "$plugin" &>/dev/null; then
        echo "  ✓ $plugin"
    else
        echo "  ⚠ $plugin (already enabled or not found)"
    fi
done
echo ""

# Enable completions
echo "Enabling completions..."
for completion in system bash-it aliases; do
    if bash-it enable completion "$completion" &>/dev/null; then
        echo "  ✓ $completion"
    else
        echo "  ⚠ $completion (already enabled or not found)"
    fi
done
echo ""

# Install custom envy theme
if [ -f "$SCRIPT_DIR/bash-it-envy.theme.bash" ]; then
    echo "Installing custom envy theme..."
    mkdir -p "$BASH_IT_DIR/themes/envy"
    cp "$SCRIPT_DIR/bash-it-envy.theme.bash" "$BASH_IT_DIR/themes/envy/envy.theme.bash"
    echo "  ✓ Custom envy theme installed"
    echo ""
else
    echo "⚠ Custom theme file not found: $SCRIPT_DIR/bash-it-envy.theme.bash"
    echo ""
fi

# Apply base theme patch
if [ -f "$SCRIPT_DIR/bash-it-base.theme.patch" ]; then
    echo "Applying base theme customizations..."
    cd "$BASH_IT_DIR"
    if patch -p1 --dry-run < "$SCRIPT_DIR/bash-it-base.theme.patch" &>/dev/null; then
        patch -p1 < "$SCRIPT_DIR/bash-it-base.theme.patch" &>/dev/null
        echo "  ✓ Base theme patch applied"
    else
        echo "  ⚠ Base theme patch already applied or conflicts exist"
    fi
    cd "$SCRIPT_DIR"
    echo ""
else
    echo "⚠ Base theme patch not found: $SCRIPT_DIR/bash-it-base.theme.patch"
    echo ""
fi

echo "=== Setup Complete! ==="
echo ""
echo "Your bash-it configuration:"
echo "  Theme: envy (custom with base theme modifications)"
echo "  Aliases: general, node"
echo "  Plugins: nvm, base, colors, docker-compose, git, man"
echo "  Completions: system, bash-it, aliases"
echo ""
echo "Custom modifications:"
echo "  - Envy theme: removed ruby prompt, changed arrow to $"
echo "  - Base theme: added newline + backslash to git_prompt_info"
echo ""
echo "Reload your shell or run: source ~/.bashrc"
