# Sensitive files - never commit these
.ssh/id_*
.ssh/*.pem
.ssh/*.key
.gnupg/
.password-store/
.aws/credentials
.docker/config.json

# Files that often contain secrets
.env
.env.*
*.key
*.pem
*.p12
*.pfx
*_rsa
*_dsa
*_ecdsa
*_ed25519

# API tokens and credentials
.netrc
.authinfo
.curlrc

# Cloud provider configs with potential credentials
.azure/
.config/gcloud/
.kube/config

# Database configs that might have passwords
.pgpass
.my.cnf
.psqlrc

# Backup files and system files
*~
*.swp
*.swo
.DS_Store
Thumbs.db

# Local testing/temporary
test_secrets.sh
local_config.sh
